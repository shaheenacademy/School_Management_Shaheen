<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="compose">
        <h2>
            <i class="fa-solid fa-photo-film me-2 text-primary"></i> 
            <span><%= photo ? 'Edit' : 'Upload New' %></span> Gallery Photo
        </h2>
        <p class="text-muted">Upload high-resolution campus photos, specify categories, and write descriptions for the public gallery.</p>
    </div>

    <div class="admin-form-card border rounded shadow-sm bg-white p-4" style="max-width: 850px;">
        <form action="<%= action %>" method="post" enctype="multipart/form-data">
            
            <!-- Photo Title -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-heading text-primary"></i> Photo Title / Subject
                </label>
                <input class="form-control" type="text" name="photoTitle" placeholder="e.g. Annual STEM Science & Innovation Showcase" value="<%= photo ? photo.title : '' %>" required>
                <small class="text-muted d-block mt-1">Descriptive headline for the photo or event.</small>
            </div>

            <!-- Category & Date Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-tags text-primary"></i> Category
                    </label>
                    <select class="form-select" name="photoCategory" required>
                        <option value="Campus" <%= (photo && photo.category === 'Campus') ? 'selected' : '' %>>Campus & Infrastructure</option>
                        <option value="Academic & Labs" <%= (photo && photo.category === 'Academic & Labs') ? 'selected' : '' %>>Academic & Laboratories</option>
                        <option value="Events" <%= (photo && photo.category === 'Events') ? 'selected' : '' %>>Events & Celebrations</option>
                        <option value="Sports & Activities" <%= (photo && photo.category === 'Sports & Activities') ? 'selected' : '' %>>Sports & Activities</option>
                        <option value="Hostel Life" <%= (photo && photo.category === 'Hostel Life') ? 'selected' : '' %>>Hostel Life & Residential</option>
                        <option value="Achievements" <%= (photo && photo.category === 'Achievements') ? 'selected' : '' %>>Achievements & Awards</option>
                    </select>
                    <small class="text-muted d-block mt-1">Allows visitors to filter photos by section.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-regular fa-calendar text-primary"></i> Date / Session Tag
                    </label>
                    <input class="form-control" type="text" name="photoDate" placeholder="e.g. Aug 2026, Session 2025-26" value="<%= photo ? photo.date : 'Aug 2026' %>">
                    <small class="text-muted d-block mt-1">Displayed in the metadata tag on the gallery card.</small>
                </div>
            </div>

            <!-- Image Upload & URL Fallback -->
            <div class="mb-4 p-3 bg-light rounded border">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-cloud-arrow-up text-primary"></i> Photo Image File or URL
                </label>
                
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label text-muted small fw-semibold">Upload Image File (Recommended)</label>
                        <input type="file" name="galleryImage" id="galleryImageInput" class="form-control" accept="image/*" onchange="previewGalleryImage(this)">
                        <small class="text-muted d-block mt-1">Supports JPG, PNG, WEBP, GIF. Max file size: 10MB.</small>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label text-muted small fw-semibold">Or Image URL / Local Asset Path</label>
                        <input type="text" name="imageUrl" id="galleryUrlInput" class="form-control" placeholder="e.g. /img/slide1.jpg or https://..." value="<%= (photo && photo.image && !photo.image.startsWith('data:')) ? photo.image : '' %>" oninput="previewGalleryUrl(this.value)">
                        <small class="text-muted d-block mt-1">Existing path in public assets or remote link.</small>
                    </div>
                </div>

                <!-- Current / Preview Thumbnail -->
                <div id="galleryPreviewContainer" class="mt-3 <%= (photo && photo.image) ? '' : 'd-none' %>">
                    <span class="text-muted small d-block mb-1 fw-semibold">Image Preview:</span>
                    <div class="position-relative d-inline-block border rounded overflow-hidden shadow-sm" style="max-width: 420px; max-height: 240px;">
                        <img id="galleryPreviewImg" src="<%= (photo && photo.image) ? photo.image : '' %>" alt="Photo preview" style="width: 100%; height: 220px; object-fit: cover; display: block;" onerror="this.src='/img/slide1.jpg'">
                    </div>
                </div>
            </div>

            <!-- Photo Description / Caption -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-paragraph text-primary"></i> Description / Caption
                </label>
                <textarea class="form-control" name="photoDescription" rows="3" placeholder="e.g. Students participating in the annual science fair and demonstrating automated solar trackers to visiting judges."><%= photo ? photo.description : '' %></textarea>
                <small class="text-muted d-block mt-1">Displayed in the lightbox modal and preview cards.</small>
            </div>

            <!-- Display Order, Featured & Active Toggles -->
            <div class="row g-3 mb-4 align-items-center">
                <div class="col-md-4">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-sort text-primary"></i> Display Order Index
                    </label>
                    <input class="form-control" type="number" name="photoOrder" placeholder="1" value="<%= photo ? photo.order : 1 %>">
                    <small class="text-muted d-block mt-1">Lower order numbers show first.</small>
                </div>
                <div class="col-md-4 pt-3">
                    <div class="form-check form-switch d-flex align-items-center gap-2">
                        <input class="form-check-input" type="checkbox" name="photoActive" id="photoActive" role="switch" <%= (!photo || photo.active) ? 'checked' : '' %> style="width: 2.5em; height: 1.3em;">
                        <label class="form-check-label fw-semibold" for="photoActive">
                            Visible in Gallery (Active)
                        </label>
                    </div>
                    <small class="text-muted d-block ms-5">Toggle off to hide without deleting.</small>
                </div>
                <div class="col-md-4 pt-3">
                    <div class="form-check form-switch d-flex align-items-center gap-2">
                        <input class="form-check-input" type="checkbox" name="photoFeatured" id="photoFeatured" role="switch" <%= (photo && photo.featured) ? 'checked' : '' %> style="width: 2.5em; height: 1.3em;">
                        <label class="form-check-label fw-semibold" for="photoFeatured">
                            Highlight / Featured
                        </label>
                    </div>
                    <small class="text-muted d-block ms-5">Marks as featured milestone.</small>
                </div>
            </div>

            <!-- Actions -->
            <div class="admin-form-actions d-flex align-items-center gap-3 pt-3 border-top">
                <button type="submit" class="btn btn-primary px-4 py-2" style="font-weight: 600;">
                    <i class="fa-solid fa-check me-1"></i> <%= photo ? 'Update Photo' : 'Publish to Gallery' %>
                </button>
                <a href="/admin-gallery" class="btn btn-outline-secondary px-3 py-2" style="text-decoration: none;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewGalleryImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewImg = document.getElementById('galleryPreviewImg');
                const container = document.getElementById('galleryPreviewContainer');
                previewImg.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewGalleryUrl(url) {
        if (url && url.trim().length > 0) {
            const previewImg = document.getElementById('galleryPreviewImg');
            const container = document.getElementById('galleryPreviewContainer');
            previewImg.src = url.trim();
            container.classList.remove('d-none');
        }
    }
</script>

<%- include('partials/footer'); -%>
