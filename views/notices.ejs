<%- include('partials/header'); -%>

<div class="page-content">
    <!-- Notice Hero Header -->
    <div class="admission-hero-banner mb-4" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); color: #fff; border-radius: var(--radius, 12px); padding: 2.75rem 2rem; position: relative; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(49, 46, 129, 0.25);">
        <div style="position: absolute; right: -20px; bottom: -30px; opacity: 0.12; font-size: 15rem; pointer-events: none;">
            <i class="fa-solid fa-bullhorn"></i>
        </div>
        <div style="max-width: 800px; position: relative; z-index: 2;">
            <span class="badge" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); color: #c7d2fe; font-size: 0.85rem; font-weight: 600; padding: 0.4rem 0.9rem; border-radius: 999px; margin-bottom: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid rgba(255,255,255,0.3);">
                <i class="fa-solid fa-bell"></i> Official Academy Communications
            </span>
            <h1 style="font-size: 2.2rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.75rem; color: #fff;">
                Notice Board & <span style="color: #93c5fd;">Circulars</span>
            </h1>
            <p style="font-size: 1.02rem; line-height: 1.6; opacity: 0.95; margin-bottom: 1.25rem; color: #e0e7ff;">
                Stay updated with the latest institutional circulars, academic schedules, scholarship announcements, exam timetables, and campus notifications from Shaheen Academy Badarpur.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <a href="#notice-board-list" class="btn btn-sm" style="background: #38bdf8; color: #0f172a; font-weight: 700; padding: 0.6rem 1.2rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-arrow-down"></i> Latest Notices
                </a>
                <a href="/contact" class="btn btn-sm" style="background: rgba(255,255,255,0.15); color: #fff; font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 8px; text-decoration: none; border: 1px solid rgba(255,255,255,0.4); display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-headset"></i> Administrative Desk
                </a>
            </div>
        </div>
    </div>

    <!-- Search & Active Filter Controls -->
    <div class="card border mb-4 p-3 bg-white shadow-sm" style="border-radius: var(--radius, 12px);" id="notice-board-list">
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="noticeSearchInput" class="form-control border-start-0 bg-light" placeholder="Search notices by keyword, title, or circular type...">
        </div>
    </div>

    <% if (typeof selectedCategory !== 'undefined' && selectedCategory && selectedCategory !== 'all') { %>
    <div class="gallery-active-category-banner mb-4 d-flex justify-content-between align-items-center p-3 rounded flex-wrap gap-2" style="background:#f0f9ff; color:#0369a1; border:1px solid #bae6fd;">
        <span><i class="fa-solid fa-filter text-primary me-1"></i> Category Filter: <strong><%= selectedCategory %></strong> (<%= notices.length %> <%= notices.length === 1 ? 'notice' : 'notices' %>)</span>
        <a href="/notices" class="btn btn-sm btn-outline-primary bg-white text-decoration-none"><i class="fa-solid fa-xmark me-1"></i> Show All Notices</a>
    </div>
    <% } %>

    <!-- Notice List -->
    <% if (!notices || notices.length === 0) { %>
    <div class="text-center p-5 bg-white border rounded shadow-sm">
        <i class="fa-solid fa-bullhorn text-muted mb-3" style="font-size: 3rem;"></i>
        <h4 class="fw-bold"><%= (typeof selectedCategory !== 'undefined' && selectedCategory && selectedCategory !== 'all') ? `No Notices Found in "${selectedCategory}"` : 'No Active Notices Currently' %></h4>
        <p class="text-muted mb-0"><%= (typeof selectedCategory !== 'undefined' && selectedCategory && selectedCategory !== 'all') ? 'There are no active notices published under this category.' : 'Official notices and circulars will be published here as soon as announced.' %></p>
        <% if (typeof selectedCategory !== 'undefined' && selectedCategory && selectedCategory !== 'all') { %>
        <a href="/notices" class="btn btn-primary mt-3">
            <i class="fa-solid fa-arrow-left me-1"></i> View All Notices
        </a>
        <% } %>
    </div>
    <% } else { %>
    <div class="d-flex flex-column gap-3 mb-5" id="noticesContainer">
        <% notices.forEach(function(item) { %>
        <div class="card border notice-item-card bg-white shadow-sm" 
             style="border-radius: var(--radius, 12px); transition: all 0.2s ease; border-left: <%= item.isUrgent ? '5px solid #ef4444' : '5px solid #3b82f6' %> !important;"
             data-category="<%= (item.category || '') + ' ' + (item.title || '') + ' ' + (item.content || '') %>"
             data-urgent="<%= item.isUrgent ? 'true' : 'false' %>">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge <%= item.isUrgent ? 'bg-danger text-white' : 'bg-primary-subtle text-primary border border-primary-subtle' %>" style="font-size: 0.75rem; padding: 0.35rem 0.65rem; border-radius: 6px; font-weight: 600;">
                            <i class="fa-solid <%= item.isUrgent ? 'fa-triangle-exclamation' : 'fa-tag' %> me-1"></i>
                            <%= item.category || 'General Notice' %>
                        </span>
                        <% if (item.isUrgent) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold" style="font-size: 0.72rem; padding: 0.35rem 0.6rem;">
                            <i class="fa-solid fa-fire me-1"></i> Urgent Circular
                        </span>
                        <% } %>
                        <% if (item.targetAudience) { %>
                        <span class="badge bg-light text-muted border" style="font-size: 0.75rem; padding: 0.35rem 0.65rem;">
                            <i class="fa-solid fa-users me-1"></i> <%= item.targetAudience %>
                        </span>
                        <% } %>
                    </div>
                    <div class="text-muted small fw-medium d-flex align-items-center gap-1" style="font-size: 0.82rem;">
                        <i class="fa-regular fa-calendar text-primary"></i> <%= item.noticeDate || new Date(item.createdAt).toLocaleDateString("en-GB", { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </div>
                </div>

                <h3 class="h5 fw-bold mb-2" style="color: #0f172a; line-height: 1.35;">
                    <%= item.title %>
                </h3>

                <div class="text-muted small mb-3" style="line-height: 1.65; white-space: pre-wrap; font-size: 0.9rem; color: #475569;">
                    <%= item.content %>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                    <div>
                        <% if (item.attachmentUrl && item.attachmentUrl.trim() !== "" && item.attachmentUrl !== "#") { %>
                        <a href="<%= item.attachmentUrl %>" <%= item.attachmentUrl.startsWith('http') ? 'target="_blank"' : '' %> class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                            <i class="fa-solid fa-paperclip"></i> View Related Page / Document
                        </a>
                        <% } %>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/contact" class="btn btn-sm btn-light border text-muted d-inline-flex align-items-center gap-1">
                            <i class="fa-solid fa-circle-question"></i> Help Desk
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
    <% } %>

    <!-- Notice Advisory Box -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border p-4 bg-white h-100 shadow-sm" style="border-radius: var(--radius, 12px);">
                <h4 class="h6 fw-bold mb-2 d-flex align-items-center gap-2" style="color: #0f172a;">
                    <i class="fa-solid fa-circle-info text-primary"></i> Official Communication Advisory
                </h4>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                    All official notices published on this portal are authorized by the Academic Council and Principal's Office of Shaheen Academy Badarpur. Parents and students are advised to rely strictly on announcements published on this page or through official SMS alerts.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border p-4 bg-white h-100 shadow-sm" style="border-radius: var(--radius, 12px);">
                <h4 class="h6 fw-bold mb-2 d-flex align-items-center gap-2" style="color: #0f172a;">
                    <i class="fa-solid fa-phone-volume text-success"></i> Notice Verification Helpline
                </h4>
                <p class="text-muted small mb-2" style="line-height: 1.6;">
                    For inquiries or clarification regarding any notice, please contact the academy reception or student grievance desk:
                </p>
                <div class="d-flex gap-3 small flex-wrap">
                    <span class="text-dark fw-medium"><i class="fa-solid fa-phone text-primary me-1"></i> +91 98765 43210</span>
                    <span class="text-dark fw-medium"><i class="fa-solid fa-envelope text-primary me-1"></i> notice@shaheenacademybadarpur.in</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('noticeSearchInput');
        const cards = document.querySelectorAll('.notice-item-card');

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                cards.forEach(card => {
                    const categoryData = (card.getAttribute('data-category') || '').toLowerCase();
                    if (!query || categoryData.includes(query)) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        }
    });
</script>

<%- include('partials/footer'); -%>
