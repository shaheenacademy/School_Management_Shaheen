<%- include('partials/header'); -%>

<div class="page-content">
    <% if(learn.length === 0) { %>
        <div class="about-card text-center py-5">
            <i class="fa-solid fa-book-open" style="font-size:2.5rem; color:var(--text-muted); margin-bottom:1rem;"></i>
            <p>No learnings posted yet. Check back soon!</p>
        </div>
    <% } else { %>
        <div class="cards-grid" id="learnGrid">
            <% for(var i=0; i<learn.length; i++) { %>
                <div class="learning-box">
                    <% if (learn[i].image) { %>
                        <div class="learning-cover" style="width: calc(100% + 4rem); margin-left: -2rem; margin-top: -2.25rem; height: 180px; overflow: hidden; border-top-left-radius: 15px; border-top-right-radius: 15px; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border);">
                            <img src="<%= learn[i].image %>" alt="<%= learn[i].title %>" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                    <% } %>
                    <div class="learning-box-header mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="learning-box-tag"><i class="fa-solid fa-graduation-cap me-1"></i> Tech Note</span>
                        <% if (learn[i].date) { %>
                            <span class="learning-box-date"><i class="fa-regular fa-calendar-days me-1"></i> <%=learn[i].date%></span>
                        <% } %>
                    </div>
                    <h3 class="learning-box-title"><%=learn[i].title%></h3>
                    <p class="learning-box-excerpt mb-3"><%=learn[i].content.substring(0, 240) + (learn[i].content.length > 240 ? "..." : "")%></p>
                    <div class="learning-box-footer mt-auto pt-2">
                        <span class="learning-box-link">
                            Reference Entry <i class="fa-solid fa-book-open ms-1"></i>
                        </span>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<%- include('partials/footer'); -%>
