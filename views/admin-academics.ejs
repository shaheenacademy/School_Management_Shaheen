<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem;">
        <div class="page-header-content">
            <p class="page-label">Admin</p>
            <h1>Manage <span>Academics</span></h1>
            <p class="page-subtitle">Add, edit, or remove academic wings, curriculum details, pedagogy frameworks, and faculty highlights.</p>
        </div>
        <a href="/admin-academics/add" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:0.5rem;text-decoration:none;">
            <i class="fa-solid fa-plus"></i> Add Academic Program
        </a>
    </div>

    <% if (!academics || academics.length === 0) { %>
    <div class="admin-empty-state">
        <i class="fa-solid fa-book-open"></i>
        <p>No academic programs listed yet. <a href="/admin-academics/add" style="color:var(--primary); font-weight:600;">Create your first academic wing</a></p>
    </div>
    <% } %>

    <div class="admin-list-stack">
    <% for(var i=0; i<academics.length; i++) { %>
    <div class="blogcard admin-list-card">
        <div class="admin-list-card-body">
            <div class="admin-list-card-badges">
                <span class="admin-badge admin-badge--primary"><%= academics[i].category || 'Academic Wing' %></span>
                <% if (academics[i].grades) { %>
                <span class="admin-badge" style="background:#eef2ff; color:#4f46e5; border:1px solid #c7d2fe;"><%= academics[i].grades %></span>
                <% } %>
                <span class="admin-badge <%= academics[i].active ? 'admin-badge--success' : 'admin-badge--danger' %>">
                    <%= academics[i].active ? 'Active' : 'Inactive' %>
                </span>
                <% if (typeof academics[i].order !== 'undefined') { %>
                <span class="admin-badge" style="background:#f1f5f9; color:#475569;">Order: <%= academics[i].order %></span>
                <% } %>
            </div>
            <h3 class="admin-list-card-title d-flex align-items-center gap-2">
                <i class="<%= academics[i].icon || 'fa-solid fa-graduation-cap' %> text-primary" style="font-size: 1.1rem;"></i>
                <%= academics[i].title %>
            </h3>
            <% if (academics[i].board) { %>
            <p class="admin-list-card-meta">
                <i class="fa-solid fa-award"></i> Board: <%= academics[i].board %>
            </p>
            <% } %>
            <% if (academics[i].curriculum) { %>
            <p style="font-size:0.83rem; color:var(--text); margin-bottom:0.35rem;">
                <strong>Curriculum:</strong> <%= academics[i].curriculum %>
            </p>
            <% } %>
            <% if (academics[i].pedagogy) { %>
            <p style="font-size:0.83rem; color:var(--text-muted); margin-bottom:0.35rem;">
                <strong>Pedagogy:</strong> <%= academics[i].pedagogy %>
            </p>
            <% } %>
            <% if (academics[i].faculty) { %>
            <p style="font-size:0.83rem; color:var(--primary); font-weight:500; margin-bottom:0.35rem;">
                <strong>Faculty:</strong> <%= academics[i].faculty %>
            </p>
            <% } %>
            <p class="admin-list-card-excerpt">
                <%= academics[i].description ? (academics[i].description.substring(0,140) + (academics[i].description.length > 140 ? '...' : '')) : '' %>
            </p>
        </div>
        <div class="admin-card-actions">
            <a href="/admin-academics/edit/<%= academics[i]._id %>" class="btn-admin-edit">
                <i class="fa-solid fa-pen"></i> Edit
            </a>
            <form action="/admin-academics/delete/<%= academics[i]._id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this academic program?')">
                <button type="submit" class="btn-admin-delete">
                    <i class="fa-solid fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
    <% } %>
    </div>
</div>

<%- include('partials/footer'); -%>
