<%- include('partials/header'); -%>

<div class="container-fluid page-content my-4">
    <!-- HERO HEADER -->
    <div class="p-4 p-md-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-left: 4px solid #3b82f6;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 text-uppercase fw-semibold mb-3">
                    <i class="fa-solid fa-graduation-cap me-1"></i> Admissions Session 2026 – 2027 Open
                </span>
                <h1 class="display-6 fw-bold text-white mb-2">Shaheen Academy Admissions</h1>
                <p class="lead mb-4 text-light" style="font-size: 1.05rem; opacity: 0.9;">
                    Step into an inspiring educational journey combining rigorous board syllabus, national entrance preparation (NEET / JEE / Olympiads), moral discipline, and high-tech infrastructure.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/book" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-calendar-check me-1"></i> Book Counseling & Campus Tour
                    </a>
                    <a href="/contact" class="btn btn-outline-light px-4 py-2">
                        <i class="fa-solid fa-envelope me-1"></i> Inquire Online
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <div class="p-3 bg-white bg-opacity-10 rounded border border-light border-opacity-25 text-white">
                    <h5 class="fw-bold mb-2"><i class="fa-solid fa-award text-warning me-2"></i>Merit Scholarships</h5>
                    <p class="small text-light mb-2">Up to 100% tuition waiver for outstanding students qualifying the Shaheen Talent Search Test.</p>
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1">Limited Seats</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ADMISSION PROGRAMS LISTING -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4 border-bottom pb-3">
            <div>
                <span class="text-primary fw-bold text-uppercase small letter-spacing-1">Academic Programs</span>
                <h2 class="h3 fw-bold text-dark mb-0">Available Admission Batches</h2>
            </div>
            <p class="text-muted small mb-0">Select your preferred course stream to view eligibility and deadlines.</p>
        </div>

        <% if (!admissions || admissions.length === 0) { %>
        <div class="text-center p-5 bg-white border rounded shadow-sm">
            <i class="fa-solid fa-user-graduate fa-3x text-muted mb-3"></i>
            <h4 class="fw-bold text-dark">Admissions Opening Soon</h4>
            <p class="text-muted">New admission notifications and entrance dates will be announced shortly. Contact our admission desk for immediate inquiries.</p>
            <a href="/contact" class="btn btn-primary">Contact Admission Office</a>
        </div>
        <% } else { %>
        
        <div class="row g-4">
            <% for(var i=0; i<admissions.length; i++) { %>
            <div class="col-md-6 col-lg-4">
                <div class="admission-card">
                    <div class="admission-card-header">
                        <div class="admission-card-icon" style="background: #eef2ff; color: #3b82f6;">
                            <i class="<%= admissions[i].icon || 'fa-solid fa-user-graduate' %>"></i>
                        </div>
                        <div>
                            <span class="admission-meta-badge bg-primary-subtle text-primary border border-primary-subtle">
                                <%= admissions[i].category || 'General' %>
                            </span>
                            <h3 class="admission-card-title mt-1"><%= admissions[i].title %></h3>
                        </div>
                    </div>

                    <p class="text-muted small mb-3" style="line-height: 1.5; flex-grow: 1;"><%= admissions[i].description %></p>

                    <div class="admission-meta-list">
                        <div class="admission-meta-item">
                            <span class="admission-meta-label">Eligibility</span>
                            <span class="admission-meta-val"><%= admissions[i].eligibility || 'Board Qualified' %></span>
                        </div>
                        <div class="admission-meta-item">
                            <span class="admission-meta-label">Fee Structure</span>
                            <span class="admission-meta-val"><%= admissions[i].feeStructure || 'Contact Desk' %></span>
                        </div>
                        <div class="admission-meta-item">
                            <span class="admission-meta-label">Available Intake</span>
                            <span class="admission-meta-val"><%= admissions[i].seats || 'Limited' %></span>
                        </div>
                        <div class="admission-meta-item">
                            <span class="admission-meta-label">Last Date</span>
                            <span class="admission-meta-val text-primary"><%= admissions[i].deadline || 'Open' %></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                        <a href="/book" class="btn btn-primary btn-sm flex-grow-1 fw-semibold">
                            <i class="fa-solid fa-paper-plane me-1"></i> Apply / Book Tour
                        </a>
                        <a href="/contact" class="btn btn-outline-secondary btn-sm" title="Contact Us">
                            <i class="fa-solid fa-phone"></i>
                        </a>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <!-- 4 STEP ADMISSION PROCESS -->
    <div class="my-5 p-4 bg-white border rounded-3 shadow-sm">
        <div class="text-center mb-4">
            <span class="text-primary fw-bold text-uppercase small letter-spacing-1">How It Works</span>
            <h2 class="h3 fw-bold text-dark">4-Step Simple Admission Procedure</h2>
            <p class="text-muted small">Seamless, transparent, and student-focused onboarding.</p>
        </div>

        <div class="steps-list">
            <div class="step-card">
                <div class="step-number">1</div>
                <h4 class="h6 fw-bold text-dark mb-2">Inquiry & Registration</h4>
                <p class="text-muted small mb-0">Fill out our online inquiry form or visit the academy reception in person to receive the prospectus and registration packet.</p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h4 class="h6 fw-bold text-dark mb-2">Aptitude & Diagnostic Test</h4>
                <p class="text-muted small mb-0">Appear for the Shaheen Diagnostic & Scholarship Entrance Evaluation to determine current academic readiness and fee scholarship.</p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h4 class="h6 fw-bold text-dark mb-2">Counseling & Verification</h4>
                <p class="text-muted small mb-0">Participate in an interactive counseling session with academic mentors to select optimal subject combinations and stream tracks.</p>
            </div>
            <div class="step-card">
                <div class="step-number">4</div>
                <h4 class="h6 fw-bold text-dark mb-2">Enrollment & Onboarding</h4>
                <p class="text-muted small mb-0">Submit documentation, complete fee enrollment, and receive your student ID, syllabus kits, timetable, and hostel room allotment.</p>
            </div>
        </div>
    </div>

    <!-- REQUIRED DOCUMENTS & SCHOLARSHIP SECTION -->
    <div class="row g-4 my-4">
        <div class="col-lg-6">
            <div class="p-4 bg-white border rounded-3 h-100 shadow-sm">
                <h3 class="h5 fw-bold text-dark mb-3">
                    <i class="fa-solid fa-folder-open text-primary me-2"></i> Mandatory Documents Required
                </h3>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                    <li class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success"></i> 4 Passport-size recent color photographs
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success"></i> Attested copy of previous class marksheet / report card
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success"></i> Original Transfer Certificate (TC) and Migration Certificate
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success"></i> Copy of Aadhaar Card (Student & Guardian)
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success"></i> Category / EWS / Minority certificate (if applying for fee concession)
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-4 bg-white border rounded-3 h-100 shadow-sm d-flex flex-column justify-content-between">
                <div>
                    <h3 class="h5 fw-bold text-dark mb-3">
                        <i class="fa-solid fa-hand-holding-dollar text-primary me-2"></i> Scholarships & Financial Support
                    </h3>
                    <p class="small text-muted mb-3">
                        Shaheen Academy firmly believes financial constraints should never hinder academic talent. We offer merit-based waivers, sibling concessions, and special support for economically weaker meritorious students.
                    </p>
                </div>
                <div class="d-flex gap-3">
                    <a href="/book" class="btn btn-primary btn-sm px-3 py-2 fw-semibold">
                        Schedule Admission Meeting
                    </a>
                    <a href="/contact" class="btn btn-outline-secondary btn-sm px-3 py-2">
                        Request Fee Details
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer'); -%>
