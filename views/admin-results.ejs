<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem;">
        <div class="page-header-content">
            <p class="page-label">Admin</p>
            <h1>Manage <span>Results & Toppers</span></h1>
            <p class="page-subtitle">Publish, edit, and organize competitive exam ranks, board results, toppers lists, and merit scholarship scores.</p>
        </div>
        <a href="/admin-results/add" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:0.5rem;text-decoration:none;">
            <i class="fa-solid fa-plus"></i> Add Examination Result
        </a>
    </div>

    <% if (!results || results.length === 0) { %>
    <div class="admin-empty-state">
        <i class="fa-solid fa-award"></i>
        <p>No results published yet. <a href="/admin-results/add" style="color:var(--primary); font-weight:600;">Add your first result record</a></p>
    </div>
    <% } %>

    <div class="admin-list-stack">
    <% for(var i=0; i<results.length; i++) { %>
    <div class="blogcard admin-list-card">
        <div class="admin-list-card-body">
            <div class="admin-list-card-badges">
                <span class="admin-badge admin-badge--primary"><%= results[i].category || 'Competitive Exam' %></span>
                <span class="admin-badge" style="background:#eef2ff; color:#4f46e5; border:1px solid #c7d2fe;">Session <%= results[i].session || '2024 - 2025' %></span>
                <% if (results[i].badge) { %>
                <span class="admin-badge" style="background:#ecfdf5; color:#059669; border:1px solid #a7f3d0;"><%= results[i].badge %></span>
                <% } %>
                <span class="admin-badge <%= results[i].active ? 'admin-badge--success' : 'admin-badge--danger' %>">
                    <%= results[i].active ? 'Active' : 'Inactive' %>
                </span>
                <% if (typeof results[i].order !== 'undefined') { %>
                <span class="admin-badge" style="background:#f1f5f9; color:#475569;">Order: <%= results[i].order %></span>
                <% } %>
            </div>
            <h3 class="admin-list-card-title d-flex align-items-center gap-2">
                <i class="fa-solid fa-trophy text-warning" style="font-size: 1.1rem;"></i>
                <%= results[i].title %>
            </h3>
            <% if (results[i].highlight) { %>
            <p class="admin-list-card-meta text-success fw-bold">
                <i class="fa-solid fa-fire text-danger"></i> <%= results[i].highlight %>
            </p>
            <% } %>
            <% if (results[i].toppersCount) { %>
            <p style="font-size:0.83rem; color:var(--text); margin-bottom:0.35rem;">
                <strong>Benchmark:</strong> <%= results[i].toppersCount %>
            </p>
            <% } %>
            <% if (results[i].toppersList) { %>
            <div style="font-size:0.8rem; color:#475569; background:#f8fafc; padding:0.5rem 0.75rem; border-radius:6px; margin-bottom:0.5rem; max-height:80px; overflow:hidden; text-overflow:ellipsis; white-space:pre-line;">
                <%= results[i].toppersList.substring(0, 180) %><%= results[i].toppersList.length > 180 ? '...' : '' %>
            </div>
            <% } %>
            <p class="admin-list-card-excerpt">
                <%= results[i].description ? (results[i].description.substring(0,140) + (results[i].description.length > 140 ? '...' : '')) : '' %>
            </p>
            <% if (results[i].pdfUrl) { %>
            <p style="font-size:0.78rem; color:var(--primary); margin-bottom:0;">
                <i class="fa-solid fa-file-pdf"></i> Scorecard Link: <a href="<%= results[i].pdfUrl %>" target="_blank"><%= results[i].pdfUrl %></a>
            </p>
            <% } %>
        </div>
        <div class="admin-card-actions">
            <a href="/admin-results/edit/<%= results[i]._id %>" class="btn-admin-edit">
                <i class="fa-solid fa-pen"></i> Edit
            </a>
            <form action="/admin-results/delete/<%= results[i]._id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this result entry?')">
                <button type="submit" class="btn-admin-delete">
                    <i class="fa-solid fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
    <% } %>
    </div>
</div>

<%- include('partials/footer'); -%>
