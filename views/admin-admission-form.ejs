<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="compose">
        <h2>
            <i class="fa-solid fa-user-graduate me-2 text-primary"></i> 
            <span><%= admission ? 'Edit' : 'Create' %></span> Admission Program
        </h2>
        <p class="text-muted">Define admission criteria, grade levels, fees, deadlines, and requirements for incoming students.</p>
    </div>

    <div class="admin-form-card border rounded shadow-sm bg-white p-4" style="max-width: 850px;">
        <form action="<%= action %>" method="post">
            
            <!-- Program Title -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-heading text-primary"></i> Admission Program Title / Batch Name
                </label>
                <input class="form-control" type="text" name="admissionTitle" placeholder="e.g. Class XI Integrated Science & NEET/JEE Residential Batch 2026-27" value="<%= admission ? admission.title : '' %>" required>
                <small class="text-muted d-block mt-1">Official title displayed on the admissions portal.</small>
            </div>

            <!-- Category & Icon Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-tags text-primary"></i> Category
                    </label>
                    <select class="form-select" name="admissionCategory" required>
                        <option value="Senior Secondary" <%= (admission && admission.category === 'Senior Secondary') ? 'selected' : '' %>>Senior Secondary (Class 11 - 12)</option>
                        <option value="Secondary" <%= (admission && admission.category === 'Secondary') ? 'selected' : '' %>>Secondary (Class 6 - 10)</option>
                        <option value="Integrated Coaching" <%= (admission && admission.category === 'Integrated Coaching') ? 'selected' : '' %>>Integrated Coaching (NEET / JEE)</option>
                        <option value="Pre-Foundation" <%= (admission && admission.category === 'Pre-Foundation') ? 'selected' : '' %>>Pre-Foundation (Class 8 - 10)</option>
                        <option value="Scholarship" <%= (admission && admission.category === 'Scholarship') ? 'selected' : '' %>>Scholarship & Entrance Exam</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-icons text-primary"></i> Icon Class (FontAwesome)
                    </label>
                    <input class="form-control" type="text" name="admissionIcon" placeholder="e.g. fa-solid fa-user-graduate" value="<%= admission ? admission.icon : 'fa-solid fa-user-graduate' %>">
                    <small class="text-muted d-block mt-1">FontAwesome icon CSS class name.</small>
                </div>
            </div>

            <!-- Eligibility & Fee Structure -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-clipboard-check text-primary"></i> Eligibility Criteria
                    </label>
                    <input class="form-control" type="text" name="admissionEligibility" placeholder="e.g. Min 75% in Class 10 Board + Entrance Test" value="<%= admission ? admission.eligibility : '' %>">
                    <small class="text-muted d-block mt-1">Minimum qualifying marks, subjects, or age limit.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-indian-rupee-sign text-primary"></i> Fee Structure / Installments
                    </label>
                    <input class="form-control" type="text" name="admissionFeeStructure" placeholder="e.g. ₹45,000 / Year (Scholarships Available)" value="<%= admission ? admission.feeStructure : '' %>">
                    <small class="text-muted d-block mt-1">Indicative tuition and installment guidelines.</small>
                </div>
            </div>

            <!-- Seats & Deadline -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-users-rectangle text-primary"></i> Seat Capacity / Intake
                    </label>
                    <input class="form-control" type="text" name="admissionSeats" placeholder="e.g. 60 Seats (Merit & Entrance Based)" value="<%= admission ? admission.seats : '' %>">
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-regular fa-calendar-check text-primary"></i> Application Deadline / Test Date
                    </label>
                    <input class="form-control" type="text" name="admissionDeadline" placeholder="e.g. 30 Nov 2026 or Rolling Admissions" value="<%= admission ? admission.deadline : '' %>">
                </div>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-paragraph text-primary"></i> Detailed Description & Highlights
                </label>
                <textarea class="form-control" name="admissionDescription" rows="4" placeholder="Detailed breakdown of the program, coaching methodology, hostel accommodation, and entrance steps..." required><%= admission ? admission.description : '' %></textarea>
            </div>

            <!-- Order & Active State -->
            <div class="row g-3 mb-4 align-items-center">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-sort text-primary"></i> Display Priority Index
                    </label>
                    <input class="form-control" type="number" name="admissionOrder" placeholder="1" value="<%= admission ? admission.order : 1 %>">
                    <small class="text-muted d-block mt-1">Lower order numbers are displayed first.</small>
                </div>
                <div class="col-md-6 pt-3">
                    <div class="form-check form-switch d-flex align-items-center gap-2">
                        <input class="form-check-input" type="checkbox" name="admissionActive" id="admissionActive" role="switch" <%= (!admission || admission.active) ? 'checked' : '' %> style="width: 2.5em; height: 1.3em;">
                        <label class="form-check-label fw-semibold" for="admissionActive">
                            Active & Visible on Public Admissions Page
                        </label>
                    </div>
                    <small class="text-muted d-block ms-5">Toggle off to archive or temporarily unpublish.</small>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="admin-form-actions d-flex align-items-center gap-3 pt-3 border-top">
                <button type="submit" class="btn btn-primary px-4 py-2" style="font-weight: 600;">
                    <i class="fa-solid fa-check me-1"></i> <%= admission ? 'Update Program' : 'Publish Program' %>
                </button>
                <a href="/admin-admissions" class="btn btn-outline-secondary px-3 py-2" style="text-decoration: none;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer'); -%>
