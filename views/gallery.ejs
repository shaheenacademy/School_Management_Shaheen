<%- include('partials/header'); -%>

<div class="page-content">
    <div class="page-header text-center" style="max-width: 780px; margin: 0 auto 1rem; text-align: center;">
        <p class="section-indicator justify-content-center" style="display:inline-flex; margin-bottom: 0.4rem;">
            <i class="fa-solid fa-camera text-primary"></i> CAMPUS LIFE & MEDIA
        </p>
        <h1 style="letter-spacing: -0.02em;">Academy Photo <span>Gallery</span></h1>
        <p class="text-muted" style="font-size: 0.95rem; line-height: 1.5; margin-bottom: 0.5rem;">
            Explore glimpses of our state-of-the-art campus, advanced scientific laboratories, cultural events, academic milestones, and dynamic student life.
        </p>
        
        <% if (typeof selectedCategory !== 'undefined' && selectedCategory && selectedCategory !== 'all') { %>
        <div class="gallery-active-category-banner mt-2">
            <span><i class="fa-solid fa-filter text-primary me-1"></i> Category: <%= selectedCategory %> (<%= galleries.length %> <%= galleries.length === 1 ? 'photo' : 'photos' %>)</span>
            <a href="/gallery" class="gallery-clear-filter-btn"><i class="fa-solid fa-xmark me-1"></i> Show All Photos</a>
        </div>
        <% } %>
    </div>

    <!-- Gallery Grid -->
    <% if (galleries.length === 0) { %>
    <div class="admin-empty-state text-center p-3 bg-white border rounded my-2">
        <i class="fa-solid fa-images fa-2x text-muted mb-2"></i>
        <h3>No Photos Found</h3>
        <p class="text-muted"><%= (typeof selectedCategory !== 'undefined' && selectedCategory !== 'all') ? `No photos currently available in the "${selectedCategory}" category.` : 'New photos of campus life, laboratories, and events will be published shortly.' %></p>
        <% if (typeof selectedCategory !== 'undefined' && selectedCategory !== 'all') { %>
        <a href="/gallery" class="btn btn-outline-primary mt-2">
            <i class="fa-solid fa-arrow-left me-1"></i> View All Photos
        </a>
        <% } %>
    </div>
    <% } else { %>
    <div class="gallery-grid" id="galleryGrid">
        <% galleries.forEach(function(item, index) { %>
        <div class="gallery-card" data-category="<%= item.category %>" data-index="<%= index %>" onclick="openLightbox(<%= index %>)">
            <div class="gallery-img-wrap">
                <img src="<%= item.image %>" alt="<%= item.title %>" class="gallery-img" loading="lazy" onerror="this.src='/img/slide1.jpg'">
                <span class="gallery-badge"><%= item.category %></span>
                <div class="gallery-hover-overlay">
                    <div class="gallery-zoom-icon">
                        <i class="fa-solid fa-expand"></i>
                    </div>
                </div>
            </div>
            <div class="gallery-body">
                <h3 class="gallery-title"><%= item.title %></h3>
                <p class="gallery-desc"><%= item.description || 'Shaheen Academy campus highlights.' %></p>
                <div class="gallery-meta">
                    <span><i class="fa-regular fa-calendar me-1"></i> <%= item.date || 'Academic Session' %></span>
                    <span><i class="fa-solid fa-magnifying-glass-plus me-1 text-primary"></i> View</span>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
    <% } %>
</div>

<!-- Lightbox Modal -->
<div class="lightbox-modal" id="lightboxModal" role="dialog" aria-modal="true" aria-label="Photo View">
    <div class="lightbox-topbar">
        <div class="lightbox-counter" id="lightboxCounter">1 / <%= galleries.length %></div>
        <button class="lightbox-close-btn" onclick="closeLightbox()" title="Close (Esc)" aria-label="Close modal">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="lightbox-main">
        <button class="lightbox-nav-btn prev" onclick="navigateLightbox(-1)" title="Previous (Left Arrow)" aria-label="Previous image">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        
        <div class="lightbox-image-wrap">
            <img id="lightboxImage" src="" alt="Gallery Image" class="lightbox-image">
        </div>

        <button class="lightbox-nav-btn next" onclick="navigateLightbox(1)" title="Next (Right Arrow)" aria-label="Next image">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>

    <div class="lightbox-bottombar">
        <span class="lightbox-category-badge" id="lightboxCategory">Campus</span>
        <h2 class="lightbox-title" id="lightboxTitle">Photo Title</h2>
        <p class="lightbox-caption" id="lightboxCaption">Photo Description</p>
    </div>
</div>

<script>
    // Gallery Data for Lightbox
    const galleryItems = <%- JSON.stringify(galleries) %>;
    let activeLightboxIndex = 0;

    // Lightbox Controls
    function openLightbox(index) {
        if (!galleryItems || galleryItems.length === 0) return;
        activeLightboxIndex = index;
        updateLightboxContent();
        const modal = document.getElementById('lightboxModal');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        const modal = document.getElementById('lightboxModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';
    }

    function navigateLightbox(direction) {
        if (galleryItems.length <= 1) return;
        activeLightboxIndex = (activeLightboxIndex + direction + galleryItems.length) % galleryItems.length;
        updateLightboxContent();
    }

    function updateLightboxContent() {
        const item = galleryItems[activeLightboxIndex];
        if (!item) return;

        const img = document.getElementById('lightboxImage');
        img.src = item.image;
        img.alt = item.title;

        document.getElementById('lightboxTitle').textContent = item.title;
        document.getElementById('lightboxCaption').textContent = item.description || '';
        document.getElementById('lightboxCategory').textContent = item.category || 'Gallery';
        document.getElementById('lightboxCounter').textContent = `${activeLightboxIndex + 1} / ${galleryItems.length}`;
    }

    // Keyboard Shortcuts for Lightbox
    document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('lightboxModal');
        if (!modal.classList.contains('active')) return;

        if (e.key === 'Escape') {
            closeLightbox();
        } else if (e.key === 'ArrowLeft') {
            navigateLightbox(-1);
        } else if (e.key === 'ArrowRight') {
            navigateLightbox(1);
        }
    });

    // Close when clicking modal backdrop outside the main image
    document.getElementById('lightboxModal').addEventListener('click', function(e) {
        if (e.target === this || e.target.classList.contains('lightbox-main')) {
            closeLightbox();
        }
    });
</script>

<%- include('partials/footer'); -%>
