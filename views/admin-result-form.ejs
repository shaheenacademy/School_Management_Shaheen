<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="compose">
        <h2><i class="fa-solid fa-trophy me-2 text-warning"></i> <span><%= result ? 'Edit' : 'Add' %></span> Examination Result</h2>
        <p class="text-muted">Create and manage published exam results, top scorers, percentiles, and star performers.</p>
    </div>
    <div class="admin-form-card border rounded shadow-sm bg-white p-4">
        <form action="<%= action %>" method="post">
            <div class="row">
                <div class="col-md-8 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-award text-primary"></i> Result / Examination Title
                    </label>
                    <input class="form-control" type="text" name="resultTitle" placeholder="e.g. NEET (UG) 2025 Historic Medical Selections" value="<%= result ? result.title : '' %>" required>
                    <small class="text-muted d-block mt-1">Clear title for the published scorecard/result.</small>
                </div>
                <div class="col-md-4 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-tag text-primary"></i> Category
                    </label>
                    <input class="form-control" type="text" name="resultCategory" placeholder="e.g. NEET (UG), JEE (Main & Adv), CBSE Class 12, Scholarship" value="<%= result ? (result.category || 'Competitive Exam') : 'Competitive Exam' %>">
                    <small class="text-muted d-block mt-1">Classification for filtering.</small>
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-regular fa-calendar text-primary"></i> Academic Session
                    </label>
                    <input class="form-control" type="text" name="resultSession" placeholder="e.g. 2024 - 2025" value="<%= result ? (result.session || '2024 - 2025') : '2024 - 2025' %>">
                    <small class="text-muted d-block mt-1">Session year of examination.</small>
                </div>
                <div class="col-md-4 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-fire text-danger"></i> Key Highlight / Summary Stat
                    </label>
                    <input class="form-control" type="text" name="resultHighlight" placeholder="e.g. 48+ Students Qualified for Govt Medical Colleges" value="<%= result ? (result.highlight || '') : '' %>">
                    <small class="text-muted d-block mt-1">Major achievement headline.</small>
                </div>
                <div class="col-md-4 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-medal text-warning"></i> Benchmark / Highest Score
                    </label>
                    <input class="form-control" type="text" name="resultToppersCount" placeholder="e.g. Top AIR 382 | Highest Score 692/720" value="<%= result ? (result.toppersCount || '') : '' %>">
                    <small class="text-muted d-block mt-1">Top score or percentile benchmark.</small>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-success"></i> Badge Label
                    </label>
                    <input class="form-control" type="text" name="resultBadge" placeholder="e.g. Medical Record, Engineering Glory, 100% Distinction" value="<%= result ? (result.badge || 'Achievement') : 'Achievement' %>">
                    <small class="text-muted d-block mt-1">Featured pill badge.</small>
                </div>
                <div class="col-md-6 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-file-pdf text-danger"></i> Scorecard / PDF Link (Optional)
                    </label>
                    <input class="form-control" type="text" name="resultPdfUrl" placeholder="e.g. https://... or /downloads/neet-2025.pdf" value="<%= result ? (result.pdfUrl || '') : '' %>">
                    <small class="text-muted d-block mt-1">URL to downloadable PDF or external result gazette.</small>
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-list-ol text-primary"></i> Star Performers & Toppers List (Multi-line)
                    </label>
                    <textarea class="form-control font-monospace" name="resultToppersList" rows="5" placeholder="• Tahir Hussain - 692/720 (AIR 382) -> AIIMS Guwahati&#10;• Amina Sultana - 681/720 (AIR 840) -> Gauhati Medical College&#10;• Farhan Ahmed - 674/720 -> Silchar Medical College"><%= result ? (result.toppersList || '') : '' %></textarea>
                    <small class="text-muted d-block mt-1">Enter topper names, scores, AIR, and allocated colleges (one per line with bullets).</small>
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-align-left text-primary"></i> Detailed Description & Commentary
                    </label>
                    <textarea class="form-control" name="resultDescription" rows="4" placeholder="Shaheen Academy Badarpur delivered remarkable results in NEET-UG with 48+ students securing seats in prestigious Government Medical Colleges..."><%= result ? (result.description || '') : '' %></textarea>
                    <small class="text-muted d-block mt-1">Comprehensive summary of the batch performance and methodology.</small>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="fa-solid fa-arrow-down-1-9 text-primary"></i> Display Order
                    </label>
                    <input class="form-control" type="number" name="resultOrder" placeholder="0" value="<%= result ? (result.order || 0) : 0 %>">
                    <small class="text-muted d-block mt-1">Lower numbers appear first.</small>
                </div>

                <div class="col-md-6 mb-4 d-flex align-items-center">
                    <div class="admin-checkbox-row d-inline-flex align-items-center gap-2 p-3 bg-light rounded border w-100">
                        <input type="checkbox" name="resultActive" id="resultActive" <%= !result || result.active ? 'checked' : '' %>>
                        <label for="resultActive" class="user-select-none mb-0 fw-medium">
                            <i class="fa-solid fa-eye text-success me-1"></i> Active (visible on public /results page)
                        </label>
                    </div>
                </div>
            </div>

            <div class="note mb-4 p-3 bg-light border-start border-primary border-3 rounded">
                <p class="mb-0 text-muted">
                    <i class="fa-solid fa-circle-info me-1 text-primary"></i> 
                    <strong>Live Preview:</strong> Public visitors can view all active result records at 
                    <a href="/results" target="_blank" class="text-decoration-none">/results</a>.
                </p>
            </div>

            <div class="admin-form-actions d-flex align-items-center gap-3">
                <button class="btn btn-primary d-inline-flex align-items-center gap-2" type="submit">
                    <i class="fa-solid <%= result ? 'fa-check' : 'fa-plus' %>"></i>
                    <%= result ? 'Update Result Record' : 'Publish Result Record' %>
                </button>
                <a href="/admin-results" class="admin-back-link text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="fa-solid fa-arrow-left"></i> Back to list
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer'); -%>
