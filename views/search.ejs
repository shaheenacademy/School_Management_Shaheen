<%- include('partials/header'); -%>

<div class="page-content">
    <div class="compose">
        <h2><i class="fa-solid fa-magnifying-glass" style="color:var(--primary);font-size:1.4rem;margin-right:0.4rem;"></i><span>Search</span> Results</h2>
    </div>

    <!-- Search bar on results page -->
    <form action="/search" method="get" style="display:flex;gap:0.5rem;margin-bottom:2rem;max-width:400px;align-items: center;margin-left:auto;margin-right:auto;">
        <input class="form-control" type="text" name="q" value="<%= query %>" placeholder="Search..." style="font-size: 0.85rem; padding: 0.4rem 0.75rem; height: auto;">
        <button class="btn btn-primary" type="submit" style="width:auto; white-space:nowrap; font-size: 0.85rem; padding: 0.4rem 1rem; height: auto;">Search</button>
    </form>

    <% if (query) { %>
        <p style="color:var(--text-muted);margin-bottom:1.5rem;">
            Showing results for <strong>"<%= query %>"</strong> —
            <strong><%= total %></strong> result<%= total !== 1 ? 's' : '' %> found
        </p>
    <% } %>

    <% if (total === 0 && query) { %>
        <div style="text-align:center;padding:3rem 0;color:var(--text-muted);">
            <i class="fa-solid fa-circle-exclamation" style="font-size:2rem;margin-bottom:0.75rem;display:block;"></i>
            No results found for "<%= query %>". Try a different keyword.
        </div>
    <% } %>

    <% if (blogs.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-pen-to-square" style="color:var(--primary);margin-right:0.4rem;"></i>Blog Posts <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= blogs.length %>)</span></h4>
        <% blogs.forEach(function(post) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);">
            <a href="/<%= encodeURIComponent(post.title) %>" style="text-decoration:none;">
                <strong style="font-size:1rem;color:var(--primary);"><%= post.title %></strong>
            </a>
            <p style="margin:0.35rem 0 0;font-size:0.88rem;color:var(--text-muted);"><%= post.content.substring(0,160).replace(/\n/g,' ') %>...</p>
            <span style="font-size:0.76rem;color:var(--text-muted);"><i class="fa-solid fa-calendar-days"></i> <%= post.timestamp %></span>
        </div>
        <% }); %>
    </div>
    <% } %>

    <% if (learnings.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-lightbulb" style="color:var(--primary);margin-right:0.4rem;"></i>Learnings <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= learnings.length %>)</span></h4>
        <% learnings.forEach(function(item) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);">
            <a href="/learnings" style="text-decoration:none;">
                <strong style="font-size:1rem;color:var(--primary);"><%= item.title %></strong>
            </a>
            <p style="margin:0.35rem 0 0;font-size:0.88rem;color:var(--text-muted);"><%= item.content.substring(0,160).replace(/\n/g,' ') %>...</p>
            <span style="font-size:0.76rem;color:var(--text-muted);"><i class="fa-solid fa-calendar-days"></i> <%= new Date(item.date).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) %></span>
        </div>
        <% }); %>
    </div>
    <% } %>

    <% if (typeof galleries !== 'undefined' && galleries.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-images" style="color:var(--primary);margin-right:0.4rem;"></i>Gallery Photos <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= galleries.length %>)</span></h4>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;">
            <% galleries.forEach(function(photo) { %>
            <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;box-shadow:var(--card-shadow);display:flex;gap:0.85rem;align-items:center;">
                <img src="<%= photo.image %>" alt="<%= photo.title %>" style="width:70px;height:60px;object-fit:cover;border-radius:6px;" onerror="this.src='/img/slide1.jpg'">
                <div>
                    <a href="/gallery" style="text-decoration:none;">
                        <strong style="font-size:0.92rem;color:var(--primary);display:block;line-height:1.3;"><%= photo.title %></strong>
                    </a>
                    <span class="badge bg-light text-dark border" style="font-size:0.7rem;margin-top:0.3rem;"><%= photo.category %></span>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
    <% } %>

    <% if (typeof academics !== 'undefined' && academics.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-book-bookmark" style="color:var(--primary);margin-right:0.4rem;"></i>Academic Programs & Wings <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= academics.length %>)</span></h4>
        <% academics.forEach(function(item) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
                <a href="/academic" style="text-decoration:none;">
                    <strong style="font-size:1rem;color:var(--primary);"><%= item.title %></strong>
                </a>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size:0.75rem;"><%= item.category || item.grades %></span>
            </div>
            <% if (item.description) { %>
            <p style="margin:0.35rem 0 0.5rem;font-size:0.88rem;color:var(--text-muted);"><%= item.description.substring(0,160).replace(/\n/g,' ') %>...</p>
            <% } %>
            <div style="font-size:0.78rem;color:var(--text-muted);display:flex;gap:1rem;flex-wrap:wrap;">
                <% if (item.grades) { %><span><i class="fa-solid fa-layer-group"></i> <%= item.grades %></span><% } %>
                <% if (item.board) { %><span><i class="fa-solid fa-award"></i> <%= item.board %></span><% } %>
            </div>
        </div>
        <% }); %>
    </div>
    <% } %>

    <% if (typeof admissions !== 'undefined' && admissions.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-graduation-cap" style="color:var(--primary);margin-right:0.4rem;"></i>Admissions & Programs <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= admissions.length %>)</span></h4>
        <% admissions.forEach(function(item) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
                <a href="/admission" style="text-decoration:none;">
                    <strong style="font-size:1rem;color:var(--primary);"><%= item.title %></strong>
                </a>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size:0.75rem;"><%= item.grade || item.session %></span>
            </div>
            <% if (item.description) { %>
            <p style="margin:0.35rem 0 0.5rem;font-size:0.88rem;color:var(--text-muted);"><%= item.description.substring(0,160).replace(/\n/g,' ') %>...</p>
            <% } %>
            <div style="font-size:0.78rem;color:var(--text-muted);display:flex;gap:1rem;flex-wrap:wrap;">
                <% if (item.duration) { %><span><i class="fa-solid fa-clock"></i> <%= item.duration %></span><% } %>
                <% if (item.mode) { %><span><i class="fa-solid fa-school"></i> <%= item.mode %></span><% } %>
                <% if (item.deadline) { %><span><i class="fa-solid fa-calendar-check"></i> Apply by: <%= item.deadline %></span><% } %>
            </div>
        </div>
        <% }); %>
    </div>
    <% } %>

    <% if (typeof results !== 'undefined' && results.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-trophy" style="color:var(--primary);margin-right:0.4rem;"></i>Exam Results & Toppers <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= results.length %>)</span></h4>
        <% results.forEach(function(item) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
                <a href="/results" style="text-decoration:none;">
                    <strong style="font-size:1rem;color:var(--primary);"><%= item.title %></strong>
                </a>
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size:0.75rem;"><%= item.category || 'Exam Result' %></span>
            </div>
            <% if (item.highlight) { %>
            <p style="margin:0.35rem 0 0.25rem;font-size:0.88rem;color:#059669;font-weight:600;"><i class="fa-solid fa-fire text-danger"></i> <%= item.highlight %></p>
            <% } %>
            <% if (item.description) { %>
            <p style="margin:0 0 0.5rem;font-size:0.85rem;color:var(--text-muted);"><%= item.description.substring(0,160).replace(/\n/g,' ') %>...</p>
            <% } %>
            <div style="font-size:0.78rem;color:var(--text-muted);display:flex;gap:1rem;flex-wrap:wrap;">
                <% if (item.session) { %><span><i class="fa-regular fa-calendar"></i> Session: <%= item.session %></span><% } %>
                <% if (item.toppersCount) { %><span><i class="fa-solid fa-medal text-warning"></i> <%= item.toppersCount %></span><% } %>
            </div>
        </div>
        <% }); %>
    </div>
    <% } %>

    <% if (typeof notices !== 'undefined' && notices.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-bullhorn" style="color:var(--primary);margin-right:0.4rem;"></i>Notices & Circulars <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= notices.length %>)</span></h4>
        <% notices.forEach(function(item) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);<%= item.isUrgent ? 'border-left:4px solid #ef4444;' : '' %>">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
                <a href="/notices" style="text-decoration:none;">
                    <strong style="font-size:1rem;color:var(--primary);"><%= item.title %></strong>
                </a>
                <span class="badge <%= item.isUrgent ? 'bg-danger text-white' : 'bg-primary-subtle text-primary border border-primary-subtle' %>" style="font-size:0.75rem;"><%= item.category || 'Circular' %></span>
            </div>
            <p style="margin:0.35rem 0 0.5rem;font-size:0.88rem;color:var(--text-muted);"><%= item.content ? (item.content.substring(0,160).replace(/\n/g,' ') + '...') : '' %></p>
            <div style="font-size:0.78rem;color:var(--text-muted);display:flex;gap:1rem;flex-wrap:wrap;">
                <% if (item.noticeDate) { %><span><i class="fa-regular fa-calendar"></i> <%= item.noticeDate %></span><% } %>
                <% if (item.targetAudience) { %><span><i class="fa-solid fa-users"></i> <%= item.targetAudience %></span><% } %>
            </div>
        </div>
        <% }); %>
    </div>
    <% } %>

    <% if (careers.length > 0) { %>
    <div style="margin-bottom:2rem;">
        <h4 style="margin-bottom:1rem;color:var(--text);"><i class="fa-solid fa-briefcase" style="color:var(--primary);margin-right:0.4rem;"></i>Careers <span style="font-size:0.85rem;color:var(--text-muted);font-weight:400;">(<%= careers.length %>)</span></h4>
        <% careers.forEach(function(job) { %>
        <div class="result-card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.4rem;margin-bottom:0.85rem;box-shadow:var(--card-shadow);">
            <a href="/careers" style="text-decoration:none;">
                <strong style="font-size:1rem;color:var(--primary);"><%= job.title %></strong>
            </a>
            <p style="margin:0.35rem 0 0;font-size:0.88rem;color:var(--text-muted);"><%= job.description.substring(0,160).replace(/\n/g,' ') %>...</p>
            <span style="font-size:0.76rem;color:var(--text-muted);"><i class="fa-solid fa-location-dot"></i> <%= job.location %> &nbsp;·&nbsp; <i class="fa-solid fa-clock"></i> <%= job.type %></span>
        </div>
        <% }); %>
    </div>
    <% } %>
</div>

<%- include('partials/footer'); -%>
