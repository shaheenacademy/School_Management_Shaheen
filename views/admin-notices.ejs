<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem;">
        <div class="page-header-content">
            <p class="page-label">Admin</p>
            <h1>Manage <span>Notices & Circulars</span></h1>
            <p class="page-subtitle">Publish official announcements, scholarship exam dates, academic notices, and urgent circulars.</p>
        </div>
        <a href="/admin-notices/add" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:0.5rem;text-decoration:none;">
            <i class="fa-solid fa-plus"></i> Post New Notice
        </a>
    </div>

    <% if (!notices || notices.length === 0) { %>
    <div class="admin-empty-state">
        <i class="fa-solid fa-bullhorn"></i>
        <p>No notices published yet. <a href="/admin-notices/add" style="color:var(--primary); font-weight:600;">Publish your first notice</a></p>
    </div>
    <% } %>

    <div class="admin-list-stack">
    <% for(var i=0; i<notices.length; i++) { %>
    <div class="blogcard admin-list-card" style="<%= notices[i].isUrgent ? 'border-left: 4px solid #ef4444;' : '' %>">
        <div class="admin-list-card-body">
            <div class="admin-list-card-badges">
                <span class="admin-badge admin-badge--primary"><%= notices[i].category || 'Academic Circular' %></span>
                <% if (notices[i].isUrgent) { %>
                <span class="admin-badge" style="background:#fef2f2; color:#ef4444; border:1px solid #fecaca; font-weight:700;">
                    <i class="fa-solid fa-triangle-exclamation"></i> URGENT
                </span>
                <% } %>
                <% if (notices[i].targetAudience) { %>
                <span class="admin-badge" style="background:#f1f5f9; color:#475569;"><i class="fa-solid fa-users"></i> <%= notices[i].targetAudience %></span>
                <% } %>
                <span class="admin-badge <%= notices[i].active ? 'admin-badge--success' : 'admin-badge--danger' %>">
                    <%= notices[i].active ? 'Active' : 'Inactive' %>
                </span>
                <% if (typeof notices[i].order !== 'undefined') { %>
                <span class="admin-badge" style="background:#f8fafc; color:#64748b;">Order: <%= notices[i].order %></span>
                <% } %>
            </div>
            <h3 class="admin-list-card-title d-flex align-items-center gap-2">
                <i class="fa-solid fa-bell <%= notices[i].isUrgent ? 'text-danger' : 'text-primary' %>" style="font-size: 1.05rem;"></i>
                <%= notices[i].title %>
            </h3>
            <p class="admin-list-card-meta">
                <i class="fa-regular fa-calendar text-primary"></i> Date: <%= notices[i].noticeDate || new Date(notices[i].createdAt).toLocaleDateString("en-GB") %>
            </p>
            <p class="admin-list-card-excerpt">
                <%= notices[i].content ? (notices[i].content.substring(0,180) + (notices[i].content.length > 180 ? '...' : '')) : '' %>
            </p>
            <% if (notices[i].attachmentUrl) { %>
            <p style="font-size:0.78rem; color:var(--primary); margin-bottom:0;">
                <i class="fa-solid fa-paperclip"></i> Link: <a href="<%= notices[i].attachmentUrl %>" target="_blank"><%= notices[i].attachmentUrl %></a>
            </p>
            <% } %>
        </div>
        <div class="admin-card-actions">
            <a href="/admin-notices/edit/<%= notices[i]._id %>" class="btn-admin-edit">
                <i class="fa-solid fa-pen"></i> Edit
            </a>
            <form action="/admin-notices/delete/<%= notices[i]._id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this notice?')">
                <button type="submit" class="btn-admin-delete">
                    <i class="fa-solid fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
    <% } %>
    </div>
</div>

<%- include('partials/footer'); -%>
