<%- include('partials/header'); -%>

<section class="page-content">
    <div class="page-header text-center">
        <div class="page-header-content mx-auto" style="max-width: 780px;">
            <p class="page-label"><i class="fa-solid fa-book-bookmark me-1"></i> Academic Ecosystem</p>
            <h1>Curriculum & <span>Academics</span></h1>
            <p class="page-subtitle">A harmonious synthesis of rigorous board excellence, integrated competitive coaching (NEET & JEE), modern STEM research labs, and value-based character mentorship.</p>
        </div>
    </div>

    <!-- ACADEMIC PILLARS STRIP -->
    <div class="card border mb-5 p-4 bg-white" style="border-radius: var(--radius); box-shadow: var(--card-shadow);">
        <h3 class="h5 mb-3 d-flex align-items-center gap-2" style="color: var(--text);">
            <i class="fa-solid fa-shapes text-primary"></i> Shaheen Academic Excellence Framework
        </h3>
        <div class="row g-3">
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-light rounded h-100 border text-center">
                    <div class="mb-2">
                        <span class="badge bg-primary rounded-circle" style="width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center; font-size:1.05rem;">
                            <i class="fa-solid fa-atom"></i>
                        </span>
                    </div>
                    <strong class="d-block mb-1" style="color: var(--text); font-size: 0.95rem;">Integrated Coaching</strong>
                    <p class="text-muted small mb-0">Dual-track mastery of board syllabus + NEET / JEE Advanced concepts simultaneously.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-light rounded h-100 border text-center">
                    <div class="mb-2">
                        <span class="badge bg-success rounded-circle" style="width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center; font-size:1.05rem;">
                            <i class="fa-solid fa-flask"></i>
                        </span>
                    </div>
                    <strong class="d-block mb-1" style="color: var(--text); font-size: 0.95rem;">Experiential Labs</strong>
                    <p class="text-muted small mb-0">Hands-on experimentation across Physics, Chemistry, Biology, and STEM Computing labs.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-light rounded h-100 border text-center">
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark rounded-circle" style="width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center; font-size:1.05rem;">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>
                    </div>
                    <strong class="d-block mb-1" style="color: var(--text); font-size: 0.95rem;">Daily Diagnostics</strong>
                    <p class="text-muted small mb-0">Daily practice sets (DPPs), chapter-wise micro drills, and AI-enabled test score analytics.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-light rounded h-100 border text-center">
                    <div class="mb-2">
                        <span class="badge bg-info text-white rounded-circle" style="width:36px; height:36px; display:inline-flex; align-items:center; justify-content:center; font-size:1.05rem;">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </span>
                    </div>
                    <strong class="d-block mb-1" style="color: var(--text); font-size: 0.95rem;">Moral Guidance</strong>
                    <p class="text-muted small mb-0">Unwavering ethical upbringing, disciplined daily schedule, and dedicated mental health care.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ACADEMIC STREAMS & PROGRAMS LIST -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-0" style="color: var(--text); font-weight: 700;">
                <i class="fa-solid fa-graduation-cap text-primary me-2"></i> Academic Programs & Specialized Wings
            </h2>
            <p class="text-muted small mb-0">Explore our structured curricula, teaching methodologies, and faculty mentoring programs.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admission" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-id-card"></i> View Admissions
            </a>
            <a href="/book" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-calendar-check"></i> Book Campus Tour
            </a>
        </div>
    </div>

    <% if (!academics || academics.length === 0) { %>
    <div class="about-card text-center py-5">
        <i class="fa-solid fa-book-open" style="font-size:2.5rem; color:var(--text-muted); margin-bottom:1rem;"></i>
        <p class="mb-2">Academic programs are currently being updated.</p>
        <p class="text-muted small">Please contact our academic desk at <a href="/contact">our contact page</a> or call <strong>+91 98765 43210</strong>.</p>
    </div>
    <% } %>

    <div class="row g-4 mb-5">
    <% for(var i=0; i<academics.length; i++) { %>
        <div class="col-lg-6">
            <div class="card h-100 border p-4 bg-white" style="border-radius: var(--radius); box-shadow: var(--card-shadow); display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3 flex-wrap">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill font-monospace" style="font-size: 0.8rem; font-weight: 600;">
                            <%= academics[i].category || 'Academic Wing' %>
                        </span>
                        <% if (academics[i].grades) { %>
                        <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.78rem;">
                            <i class="fa-solid fa-layer-group me-1"></i> <%= academics[i].grades %>
                        </span>
                        <% } %>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width: 44px; height: 44px; min-width: 44px; border-radius: 10px; background: rgba(37,99,235,0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                            <i class="<%= academics[i].icon || 'fa-solid fa-graduation-cap' %>"></i>
                        </div>
                        <h3 class="h5 mb-0" style="color: var(--text); font-weight: 700; line-height: 1.35;">
                            <%= academics[i].title %>
                        </h3>
                    </div>

                    <% if (academics[i].board) { %>
                    <div class="p-2 px-3 bg-light rounded border mb-3 small d-flex align-items-center gap-2">
                        <i class="fa-solid fa-award text-primary"></i>
                        <span><strong>Board / Affiliation:</strong> <%= academics[i].board %></span>
                    </div>
                    <% } %>

                    <% if (academics[i].curriculum) { %>
                    <div class="mb-3">
                        <small class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">Curriculum & Core Subjects</small>
                        <p class="mb-0 small" style="color: var(--text);"><i class="fa-solid fa-book-open-reader text-primary me-1"></i> <%= academics[i].curriculum %></p>
                    </div>
                    <% } %>

                    <% if (academics[i].pedagogy) { %>
                    <div class="mb-3">
                        <small class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">Teaching Methodology</small>
                        <p class="mb-0 small text-muted"><i class="fa-solid fa-chalkboard-user text-success me-1"></i> <%= academics[i].pedagogy %></p>
                    </div>
                    <% } %>

                    <% if (academics[i].faculty) { %>
                    <div class="mb-3">
                        <small class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">Faculty Mentorship</small>
                        <p class="mb-0 small text-primary fw-medium"><i class="fa-solid fa-user-tie me-1"></i> <%= academics[i].faculty %></p>
                    </div>
                    <% } %>

                    <% if (academics[i].features) { %>
                    <div class="mb-3">
                        <small class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">Key Facilities & Highlights</small>
                        <p class="mb-0 small text-muted"><i class="fa-solid fa-star text-warning me-1"></i> <%= academics[i].features %></p>
                    </div>
                    <% } %>

                    <div class="mb-4">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Academic Overview</small>
                        <p class="text-muted small mb-0" style="line-height: 1.6; white-space: pre-wrap;"><%= academics[i].description %></p>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex gap-2 flex-wrap">
                    <a href="/admission" class="btn btn-primary btn-sm flex-grow-1 text-center d-inline-flex justify-content-center align-items-center gap-1">
                        <i class="fa-solid fa-user-plus"></i> Apply for this Wing
                    </a>
                    <a href="/contact" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-envelope"></i> Inquire
                    </a>
                </div>
            </div>
        </div>
    <% } %>
    </div>

    <!-- DAILY ACADEMIC ROUTINE & PEDAGOGICAL HIGHLIGHTS -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border p-4 bg-white h-100" style="border-radius: var(--radius); box-shadow: var(--card-shadow);">
                <h3 class="h5 mb-3" style="color: var(--text);">
                    <i class="fa-solid fa-clock text-primary me-2"></i> Structured Academic Day
                </h3>
                <p class="text-muted small mb-3">Shaheen Academy's disciplined daily timetable balances classroom lectures, self-study, doubt clearance, and recreational sports:</p>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                    <li><strong style="color:var(--text);">06:30 AM - 07:30 AM:</strong> Morning Physical Fitness & Mindful Contemplation</li>
                    <li><strong style="color:var(--text);">08:30 AM - 01:30 PM:</strong> Interactive Theory Lectures & Conceptual Workshops</li>
                    <li><strong style="color:var(--text);">02:30 PM - 04:30 PM:</strong> Science Labs & Supervised DPP Solving Sessions</li>
                    <li><strong style="color:var(--text);">05:00 PM - 07:00 PM:</strong> Dedicated 1-on-1 Faculty Doubt Clearance Clinics</li>
                    <li><strong style="color:var(--text);">08:00 PM - 10:30 PM:</strong> Silent Reading Hall Guided Self-Study & Revision</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border p-4 bg-white h-100" style="border-radius: var(--radius); box-shadow: var(--card-shadow);">
                <h3 class="h5 mb-3" style="color: var(--text);">
                    <i class="fa-solid fa-microscope text-primary me-2"></i> Academic Infrastructure
                </h3>
                <p class="text-muted small mb-3">State-of-the-art academic spaces empowering conceptual understanding and hands-on learning:</p>
                <div class="d-flex flex-column gap-2 small">
                    <div><i class="fa-solid fa-check text-success me-2"></i> <strong>Modern Science Labs:</strong> Fully equipped Physics, Chemistry & Biology laboratory stations.</div>
                    <div><i class="fa-solid fa-check text-success me-2"></i> <strong>Smart Digital Classrooms:</strong> Interactive touch displays and audio-visual concept simulations.</div>
                    <div><i class="fa-solid fa-check text-success me-2"></i> <strong>Central Library & Reading Room:</strong> Over 5,000 reference volumes and competitive entrance periodicals.</div>
                    <div><i class="fa-solid fa-check text-success me-2"></i> <strong>Computer & STEM Center:</strong> High-speed internet stations for online mock tests and coding drills.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer'); -%>
