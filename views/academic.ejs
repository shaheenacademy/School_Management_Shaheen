<%- include('partials/header'); -%>

<div class="container-fluid page-content my-4">
    <!-- HERO HEADER -->
    <div class="p-4 p-md-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); border-left: 4px solid #8b5cf6;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-primary px-3 py-2 text-uppercase fw-bold mb-3">
                    <i class="fa-solid fa-graduation-cap me-1"></i> Academic Pedagogy & Curricula
                </span>
                <h1 class="display-6 fw-bold text-white mb-2">Academics at Shaheen Academy</h1>
                <p class="lead mb-4 text-light" style="font-size: 1.05rem; opacity: 0.9;">
                    A holistic learning framework blending foundational concepts, analytical thinking, hands-on scientific experimentation, and comprehensive coaching for national competitive examinations.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/admission" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-user-graduate me-1"></i> View Admissions & Batches
                    </a>
                    <a href="/learnings" class="btn btn-outline-light px-4 py-2">
                        <i class="fa-solid fa-book-open me-1"></i> Student Learning Modules
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <div class="p-3 bg-white bg-opacity-10 rounded border border-light border-opacity-25 text-white text-start">
                    <h6 class="fw-bold mb-1"><i class="fa-solid fa-award text-warning me-1"></i> Excellence Guarantee</h6>
                    <p class="small mb-0 text-light opacity-75">100% conceptual clarity through Daily Practice Papers (DPP) and personal mentoring.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- STREAM SECTION HEADER -->
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0">
                <% if (typeof selectedStream !== 'undefined' && selectedStream && selectedStream !== 'all') { %>
                    <%= selectedStream %> Stream Curricula
                <% } else { %>
                    Academic Disciplines & Streams
                <% } %>
            </h2>
            <p class="text-muted small mb-0">
                <% if (typeof selectedStream !== 'undefined' && selectedStream && selectedStream !== 'all') { %>
                    Showing dedicated academic programs for <%= selectedStream %>. <a href="/academic" class="text-primary fw-semibold ms-1">View all streams &rarr;</a>
                <% } else { %>
                    Explore our structured curricula across all grade levels, disciplines, and career tracks.
                <% } %>
            </p>
        </div>
        <% if (typeof selectedStream !== 'undefined' && selectedStream && selectedStream !== 'all') { %>
        <div>
            <a href="/academic" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5">
                <i class="fa-solid fa-layer-group text-primary"></i>
                <span>View All Streams</span>
            </a>
        </div>
        <% } %>
    </div>

    <!-- ACADEMIC CARDS LISTING -->
    <% if (!academics || academics.length === 0) { %>
    <div class="text-center p-5 bg-white border rounded shadow-sm">
        <i class="fa-solid fa-graduation-cap fa-3x text-muted mb-3"></i>
        <h4 class="fw-bold text-dark">Academic Programs Loading</h4>
        <p class="text-muted">Explore our educational syllabus and contact our academic counselor for subject selections.</p>
        <a href="/contact" class="btn btn-primary">Contact Academic Desk</a>
    </div>
    <% } else { %>
    
    <div class="row g-4 mb-5" id="publicAcademicsGrid">
        <% for(var i=0; i<academics.length; i++) { %>
        <div class="col-md-6 col-lg-4 public-academic-col" data-stream="<%= academics[i].stream %>">
            <div class="academic-card">
                <div class="academic-image-wrap">
                    <img src="<%= academics[i].image || '/img/slide2.jpg' %>" alt="<%= academics[i].title %>" onerror="this.src='/img/slide2.jpg'">
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="academic-meta-badge bg-primary-subtle text-primary border border-primary-subtle">
                        <%= academics[i].stream || 'General' %>
                    </span>
                    <span class="badge bg-light text-dark border small">
                        <i class="fa-solid fa-layer-group me-1"></i> <%= academics[i].grade || 'All Grades' %>
                    </span>
                </div>

                <h3 class="academic-card-title"><%= academics[i].title %></h3>
                <p class="text-muted small mb-3" style="line-height: 1.5; flex-grow: 1;"><%= academics[i].description %></p>

                <div class="bg-light p-2.5 rounded border small mb-3">
                    <div class="mb-1">
                        <span class="text-muted d-block" style="font-size: 0.72rem; text-transform: uppercase;">Curriculum Focus:</span>
                        <strong class="text-dark"><%= academics[i].curriculum || 'NCERT / Board Standard' %></strong>
                    </div>
                    <% if (academics[i].features) { %>
                    <div class="mt-2">
                        <span class="text-muted d-block" style="font-size: 0.72rem; text-transform: uppercase;">Methodology:</span>
                        <span class="text-secondary"><%= academics[i].features %></span>
                    </div>
                    <% } %>
                </div>

                <div class="d-flex gap-2 pt-2 border-top">
                    <a href="/admission" class="btn btn-primary btn-sm flex-grow-1 fw-semibold">
                        <i class="fa-solid fa-user-graduate me-1"></i> Enroll in Stream
                    </a>
                    <a href="/book" class="btn btn-outline-secondary btn-sm" title="Schedule Counseling">
                        <i class="fa-solid fa-calendar-check"></i>
                    </a>
                </div>
            </div>
        </div>
        <% } %>
    </div>
    <% } %>

    <!-- PILLARS OF ACADEMIC EXCELLENCE -->
    <div class="p-4 bg-white border rounded-3 shadow-sm my-5">
        <div class="text-center mb-4">
            <span class="text-primary fw-bold text-uppercase small letter-spacing-1">Shaheen Advantage</span>
            <h2 class="h3 fw-bold text-dark">5 Pillars of Our Educational Framework</h2>
            <p class="text-muted small">Empowering every learner with clarity, confidence, and competitive competence.</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-3 border rounded h-100 bg-light">
                    <div class="mb-3" style="width: 44px; height: 44px; border-radius: 50%; background: #e0e7ff; color: #4338ca; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                    <h5 class="fw-bold h6 text-dark mb-2">Expert Subject Faculty</h5>
                    <p class="text-muted small mb-0">Experienced educators with proven track records in national exams and conceptual mastery.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded h-100 bg-light">
                    <div class="mb-3" style="width: 44px; height: 44px; border-radius: 50%; background: #fef3c7; color: #b45309; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                    <h5 class="fw-bold h6 text-dark mb-2">Robotics & Digital Labs</h5>
                    <p class="text-muted small mb-0">State-of-the-art computational facilities, coding sandboxes, and interactive physics labs.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded h-100 bg-light">
                    <div class="mb-3" style="width: 44px; height: 44px; border-radius: 50%; background: #dcfce7; color: #15803d; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h5 class="fw-bold h6 text-dark mb-2">Bi-Weekly Analytics</h5>
                    <p class="text-muted small mb-0">Granular performance diagnosis with continuous feedback loops for parents and mentors.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer'); -%>
