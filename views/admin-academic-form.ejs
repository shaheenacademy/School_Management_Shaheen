<%- include('partials/admin'); -%>

<div class="page-content">
    <div class="compose">
        <h2>
            <i class="fa-solid fa-graduation-cap me-2 text-primary"></i> 
            <span><%= academic ? 'Edit' : 'Add New' %></span> Academic Stream
        </h2>
        <p class="text-muted">Configure academic disciplines, grade level curricula, subject highlights, and course imagery.</p>
    </div>

    <div class="admin-form-card border rounded shadow-sm bg-white p-4" style="max-width: 850px;">
        <form action="<%= action %>" method="post" enctype="multipart/form-data">
            
            <!-- Academic Title -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-heading text-primary"></i> Program / Stream Title
                </label>
                <input class="form-control" type="text" name="academicTitle" placeholder="e.g. Senior Secondary Integrated Science (PCMB / Medical & Engineering)" value="<%= academic ? academic.title : '' %>" required>
                <small class="text-muted d-block mt-1">Full descriptive title of the academic program.</small>
            </div>

            <!-- Stream & Grade Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-tags text-primary"></i> Academic Discipline / Stream
                    </label>
                    <select class="form-select" name="academicStream" required>
                        <option value="Science" <%= (academic && academic.stream === 'Science') ? 'selected' : '' %>>Science (PCMB / Medical / Non-Medical)</option>
                        <option value="Commerce" <%= (academic && academic.stream === 'Commerce') ? 'selected' : '' %>>Commerce (Accounts, Economics, Business)</option>
                        <option value="Arts & Humanities" <%= (academic && academic.stream === 'Arts & Humanities') ? 'selected' : '' %>>Arts & Humanities</option>
                        <option value="STEM & Coding" <%= (academic && academic.stream === 'STEM & Coding') ? 'selected' : '' %>>STEM, Robotics & Coding</option>
                        <option value="Foundational" <%= (academic && academic.stream === 'Foundational') ? 'selected' : '' %>>Foundational (Middle & High School)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-layer-group text-primary"></i> Target Grade Levels
                    </label>
                    <input class="form-control" type="text" name="academicGrade" placeholder="e.g. Class 11 - 12, Class 8 - 10, or All Grades" value="<%= academic ? academic.grade : 'Class 11 - 12' %>" required>
                </div>
            </div>

            <!-- Image Upload & URL Fallback -->
            <div class="mb-4 p-3 bg-light rounded border">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-cloud-arrow-up text-primary"></i> Stream Image or Photo
                </label>
                
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label text-muted small fw-semibold">Upload Image File (Recommended)</label>
                        <input type="file" name="academicImage" id="academicImageInput" class="form-control" accept="image/*" onchange="previewAcademicImage(this)">
                        <small class="text-muted d-block mt-1">Supports JPG, PNG, WEBP. Max size: 10MB.</small>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label text-muted small fw-semibold">Or Image URL / Local Asset Path</label>
                        <input type="text" name="imageUrl" id="academicUrlInput" class="form-control" placeholder="e.g. /img/slide1.jpg" value="<%= (academic && academic.image && !academic.image.startsWith('data:')) ? academic.image : '' %>" oninput="previewAcademicUrl(this.value)">
                    </div>
                </div>

                <div id="academicPreviewContainer" class="mt-3 <%= (academic && academic.image) ? '' : 'd-none' %>">
                    <span class="text-muted small d-block mb-1 fw-semibold">Image Preview:</span>
                    <div class="position-relative d-inline-block border rounded overflow-hidden shadow-sm" style="max-width: 420px; max-height: 220px;">
                        <img id="academicPreviewImg" src="<%= (academic && academic.image) ? academic.image : '' %>" alt="Academic preview" style="width: 100%; height: 200px; object-fit: cover; display: block;" onerror="this.src='/img/slide1.jpg'">
                    </div>
                </div>
            </div>

            <!-- Curriculum Alignment & Key Features -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-book-bookmark text-primary"></i> Curriculum & Board Alignment
                    </label>
                    <input class="form-control" type="text" name="academicCurriculum" placeholder="e.g. NCERT / CBSE + National Entrance Curriculum" value="<%= academic ? academic.curriculum : '' %>">
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-list-check text-primary"></i> Key Highlights (Comma separated)
                    </label>
                    <input class="form-control" type="text" name="academicFeatures" placeholder="e.g. Daily DPPs, AI & Smart Labs, NEET-JEE Mentorship" value="<%= academic ? academic.features : '' %>">
                </div>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid fa-paragraph text-primary"></i> Stream Description & Syllabus Overview
                </label>
                <textarea class="form-control" name="academicDescription" rows="4" placeholder="Comprehensive breakdown of subjects, laboratory experiments, classroom methodology, doubt clearing sessions, and assessments..." required><%= academic ? academic.description : '' %></textarea>
            </div>

            <!-- Display Order & Active State -->
            <div class="row g-3 mb-4 align-items-center">
                <div class="col-md-6">
                    <label class="form-label d-flex align-items-center gap-2 fw-semibold">
                        <i class="fa-solid fa-sort text-primary"></i> Display Priority Index
                    </label>
                    <input class="form-control" type="number" name="academicOrder" placeholder="1" value="<%= academic ? academic.order : 1 %>">
                    <small class="text-muted d-block mt-1">Lower order numbers show first.</small>
                </div>
                <div class="col-md-6 pt-3">
                    <div class="form-check form-switch d-flex align-items-center gap-2">
                        <input class="form-check-input" type="checkbox" name="academicActive" id="academicActive" role="switch" <%= (!academic || academic.active) ? 'checked' : '' %> style="width: 2.5em; height: 1.3em;">
                        <label class="form-check-label fw-semibold" for="academicActive">
                            Active & Visible on Public Academic Page
                        </label>
                    </div>
                    <small class="text-muted d-block ms-5">Toggle off to hide temporarily.</small>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="admin-form-actions d-flex align-items-center gap-3 pt-3 border-top">
                <button type="submit" class="btn btn-primary px-4 py-2" style="font-weight: 600;">
                    <i class="fa-solid fa-check me-1"></i> <%= academic ? 'Update Stream' : 'Save Academic Stream' %>
                </button>
                <a href="/admin-academics" class="btn btn-outline-secondary px-3 py-2" style="text-decoration: none;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewAcademicImage(input) {
        const previewContainer = document.getElementById('academicPreviewContainer');
        const previewImg = document.getElementById('academicPreviewImg');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                previewContainer.classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewAcademicUrl(url) {
        const previewContainer = document.getElementById('academicPreviewContainer');
        const previewImg = document.getElementById('academicPreviewImg');
        if (url && url.trim().length > 0) {
            previewImg.src = url.trim();
            previewContainer.classList.remove('d-none');
        }
    }
</script>

<%- include('partials/footer'); -%>
