<%- include('header'); -%>
<nav class="admin-navbar">
    <a class="admin-brand d-inline-flex align-items-center gap-2" href="/overview">
        <img src="/img/logo.png" alt="Shaheen Academy Logo" class="admin-brand-logo" style="height: 32px; width: 32px; object-fit: contain; background: #fff; border-radius: 6px; padding: 2px;">
        <span>Shaheen Admin</span>
    </a>
    <div class="admin-nav-links">
        <a href="/overview"><i class="fa-solid fa-chart-pie"></i> Overview</a>
        <a href="/admin-admissions"><i class="fa-solid fa-user-graduate"></i> Admissions</a>
        <a href="/admin-academics"><i class="fa-solid fa-graduation-cap"></i> Academics</a>
        <a href="/admin-gallery"><i class="fa-solid fa-photo-film"></i> Gallery Photos</a>
        <a href="/admin-carousel"><i class="fa-solid fa-images"></i> Home Carousel</a>
        <a href="/edithome"><i class="fa-solid fa-house-pen"></i> Update Home</a>
        <a href="/admin-homecards"><i class="fa-solid fa-rectangle-list"></i> Home Cards</a>
        <a href="/postlearnings"><i class="fa-solid fa-lightbulb"></i> Post Learnings</a>
        <a href="/compose"><i class="fa-solid fa-pen-to-square"></i> Publish Blog</a>
        <a href="/admin-careers"><i class="fa-solid fa-briefcase"></i> Careers</a>
        <a href="/admin-terms"><i class="fa-solid fa-file-contract"></i> Terms of Use</a>
        <a href="/admin-books">
            <i class="fa-solid fa-calendar-check"></i> Bookings
            <% if (adminBadges && adminBadges.pendingBookings > 0) { %>
                <span class="admin-nav-badge"><%= adminBadges.pendingBookings %></span>
            <% } %>
        </a>
        <a href="/admin-candidates">
            <i class="fa-solid fa-users"></i> Candidates
            <% if (adminBadges && adminBadges.pendingCandidates > 0) { %>
                <span class="admin-nav-badge"><%= adminBadges.pendingCandidates %></span>
            <% } %>
        </a>
        <a href="/getcontact">
            <i class="fa-solid fa-envelope"></i> Get Contacts
            <% if (adminBadges && adminBadges.contactMessages > 0) { %>
                <span class="admin-nav-badge"><%= adminBadges.contactMessages %></span>
            <% } %>
        </a>
    </div>

    <a href="/logout" class="admin-nav-logout" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
</nav>
<script>
    (function () {
        var path = window.location.pathname;
        document.querySelectorAll('.admin-nav-links a').forEach(function (link) {
            if (new URL(link.href).pathname === path) {
                link.classList.add('active');
            }
        });
    })();
</script>