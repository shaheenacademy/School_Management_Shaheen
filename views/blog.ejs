<%- include('partials/header'); -%>

<div class="page-content">
    <% if(postuser.length === 0) { %>
        <div class="about-card text-center py-5">
            <i class="fa-solid fa-newspaper" style="font-size:2.5rem; color:var(--text-muted); margin-bottom:1rem;"></i>
            <p>No blog posts yet. Check back soon!</p>
        </div>
    <% } else { %>
        <div class="cards-grid" id="blogGrid">
            <% for(var i=0; i<postuser.length; i++) { %>
                <div class="blogcard">
                    <% if (postuser[i].image) { %>
                        <div class="blogcard-cover" style="width: calc(100% + 4rem); margin-left: -2rem; margin-top: -2.25rem; height: 200px; overflow: hidden; border-top-left-radius: 15px; border-top-right-radius: 15px; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border);">
                            <img src="<%= postuser[i].image %>" alt="<%= postuser[i].title %>" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                    <% } %>
                    <div class="blogcard-header mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="blogcard-tag"><i class="fa-solid fa-feather-pointed me-1"></i> Article</span>
                        <span class="blogcard-date"><i class="fa-regular fa-calendar-days me-1"></i> <%=postuser[i].timestamp || postuser[i].date%></span>
                    </div>
                    <h3 class="blogcard-title"><%=postuser[i].title%></h3>
                    <p class="blogcard-excerpt mb-3"><%=postuser[i].content.substring(0, 240) + (postuser[i].content.length > 240 ? "..." : "")%></p>
                    <div class="blogcard-footer mt-auto pt-2">
                        <a href="/<%=encodeURIComponent(postuser[i].title)%>" class="blogcard-link">
                            Read full article <i class="fa-solid fa-arrow-right-long ms-1"></i>
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<%- include('partials/footer'); -%>
